{
  "name": "ingrediscan",
  "private": true,
  "version": "3.8.0",
  "description": "IngrediScan – installable web app that flags risky ingredients and additives in supermarket products (RO/EN).",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "bench:ocr": "node bench/ocr/run.mjs",
    "bench:labels": "node bench/ocr/make-labels.mjs",
    "bench:barcodes": "node bench/barcode/run.mjs",
    "bench:real": "node bench/real/run.mjs",
    "bench:barcodes:make": "node bench/barcode/make-images.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.7.0",
    "paddle-ocr-onnx-models": "^0.2.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
